#!/bin/bash

# shellcheck disable=SC1091,SC2154 # helpers + app/domain are provided by the YunoHost runtime
source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE SERVICE INTEGRATION IN YUNOHOST
#=================================================

# Remove the service from the list of services known by YunoHost (added by `yunohost service add`)
if ynh_hide_warnings yunohost service status "$app" >/dev/null; then
    yunohost service remove "$app"
fi

ynh_systemctl --service="$app" --action="stop"

#=================================================
# CLEANUP CONFIGURATION
#=================================================
# The apt package itself (resources.apt) is purged by YunoHost core; we only
# clean up what _ejabberd_configure wrote outside of dpkg's control.

ynh_safe_rm "/etc/nginx/conf.d/${domain}.d/ejabberd.conf"
ynh_safe_rm "/var/www/.well-known/${domain}/host-meta"

ynh_script_progression "Reloading NGINX..."
ynh_systemctl --service="nginx" --action="reload"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"

# Note: coturn is NOT removed here — it is a shared service that may be used
# by other apps on this YunoHost instance.
